{
  "name": "Sonica Dev",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 3001, 4000, 7700],
  "portsAttributes": {
    "3000": { "label": "Storefront", "onAutoForward": "notify" },
    "3001": { "label": "Admin", "onAutoForward": "notify" },
    "4000": { "label": "API", "onAutoForward": "notify" },
    "7700": { "label": "Meilisearch", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "npm install && npm run db:generate",
  "postStartCommand": ".devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
