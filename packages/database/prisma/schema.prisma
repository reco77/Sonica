generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum ProductCategory {
  HEADPHONES
  SMARTWATCH
  EARBUDS
  SPEAKER
  ACCESSORY
}

enum ImageType {
  HERO
  GALLERY
  LIFESTYLE
  THREESIXTY
}

enum DocumentType {
  MANUAL
  SPEC_SHEET
  WARRANTY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum WarrantyPlan {
  STANDARD
  EXTENDED_1Y
  EXTENDED_2Y
}

enum WarrantyStatus {
  ACTIVE
  CLAIMED
  EXPIRED
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  role         Role      @default(USER)

  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  cartItems          CartItem[]
  warranties         Warranty[]
  comparisonSessions ComparisonSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ─── Address ────────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(uuid())
  userId     String
  label      String  @default("home") // home, work, other
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean @default(false)
  phone      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Product ────────────────────────────────────────────────────────────────

model Product {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  brand         String
  tagline       String
  description   String          @db.Text
  category      ProductCategory
  specs         Json
  connectivity  Json
  batteryLife   Json?
  compatibility String[]
  releaseDate   DateTime
  featured      Boolean         @default(false)
  active        Boolean         @default(true)
  averageRating Float           @default(0)
  reviewCount   Int             @default(0)

  variants  ProductVariant[]
  images    ProductImage[]
  documents ProductDocument[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([brand])
  @@index([category])
  @@index([featured])
  @@index([active])
}

// ─── Product Variant ────────────────────────────────────────────────────────

model ProductVariant {
  id             String  @id @default(uuid())
  productId      String
  color          String
  colorHex       String
  edition        String?
  sku            String  @unique
  price          Int     // cents
  compareAtPrice Int?    // cents
  stock          Int     @default(0)

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  priceHistory PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

// ─── Product Image ──────────────────────────────────────────────────────────

model ProductImage {
  id        String    @id @default(uuid())
  productId String
  url       String
  alt       String?
  sortOrder Int       @default(0)
  type      ImageType @default(GALLERY)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─── Product Document ───────────────────────────────────────────────────────

model ProductDocument {
  id        String       @id @default(uuid())
  productId String
  url       String
  name      String
  type      DocumentType

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─── Cart Item ──────────────────────────────────────────────────────────────

model CartItem {
  id        String @id @default(uuid())
  userId    String
  variantId String
  quantity  Int

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
}

// ─── Order ──────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Int         // cents
  tax             Int         // cents
  shippingCost    Int         // cents
  total           Int         // cents
  shippingAddress Json
  trackingNumber  String?
  carrier         String?
  notes           String?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  warranty Warranty?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

// ─── Order Item ─────────────────────────────────────────────────────────────

model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  variantId       String
  productName     String
  variantColor    String
  quantity        Int
  priceAtPurchase Int    // cents

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ─── Warranty ───────────────────────────────────────────────────────────────

model Warranty {
  id        String         @id @default(uuid())
  orderId   String         @unique
  userId    String
  plan      WarrantyPlan   @default(STANDARD)
  expiresAt DateTime
  claimedAt DateTime?
  status    WarrantyStatus @default(ACTIVE)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Review ─────────────────────────────────────────────────────────────────

model Review {
  id                 String   @id @default(uuid())
  userId             String
  productId          String
  overallRating      Int      // 1-5
  soundQualityRating Int?
  comfortRating      Int?
  batteryRating      Int?
  buildQualityRating Int?
  valueRating        Int?
  title              String
  content            String   @db.Text
  pros               String[]
  cons               String[]
  deviceUsedWith     String?
  verifiedPurchase   Boolean  @default(false)
  helpfulCount       Int      @default(0)
  photos             String[]

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([overallRating])
}

// ─── Price History ──────────────────────────────────────────────────────────

model PriceHistory {
  id         String   @id @default(uuid())
  variantId  String
  price      Int      // cents
  recordedAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([recordedAt])
}

// ─── Comparison Session ─────────────────────────────────────────────────────

model ComparisonSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String?
  productIds   String[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionToken])
}
